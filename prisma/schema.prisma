  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, remaining_amount, allocated_at])
  @@map("binary_payable_lots")
}

model BinaryPayoutConsumption {
  id             String   @id @default(uuid()) @db.Uuid
