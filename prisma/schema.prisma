  courier_name                  String?                     @db.VarChar
  courier_service               String?                     @db.VarChar
  courier_quote_reference       String?                     @db.VarChar
  is_non_member_sale            Boolean                     @default(false)
  customer_name                 String?
  delivery_address              String?
  market_region_code            String?
  market_region_name            String?
  market_province_code          String?
  market_province_name          String?
  market_city_muni_code         String?
  market_city_muni_name         String?
  market_zip_code               String?
  market_location_source        String?
  fulfillment_region_code       String?
  fulfillment_region_name       String?
  fulfillment_province_code     String?
  fulfillment_province_name     String?
  fulfillment_city_muni_code    String?
  fulfillment_city_muni_name    String?
  fulfillment_outlet_name       String?
  notes                         String?
