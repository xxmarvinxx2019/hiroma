  id                          String                    @id @default(uuid())
  event_key                   String?                   @unique @db.VarChar(255)
  source_event_kind           String?                   @db.VarChar(32)
  source_event_id             String?                   @db.VarChar(255)
  rule_version                String                    @default("legacy-v1") @db.VarChar(64)
  user_id                     String
  type                        CommissionType
  amount                      Decimal                   @db.Decimal(10, 2)
  points                      Int?
  source_user_id              String?
  cascade_remainder           Decimal?                  @db.Decimal(10, 2)
  is_pair_overflow            Boolean                   @default(false)
  overflow_to                 String?
  created_at                  DateTime                  @default(now())
  overflow_user               User?                     @relation("CommissionOverflow", fields: [overflow_to], references: [id])
  source_user                 User?                     @relation("CommissionSource", fields: [source_user_id], references: [id])
  user                        User                      @relation("CommissionEarner", fields: [user_id], references: [id])
  direct_referral_reserve_lot DirectReferralReserveLot?

  @@map("commissions")
}

// Append-only source of truth for every spendable wallet mutation. Database
// triggers apply these deltas to wallets and reject direct balance changes.
model WalletLedgerEntry {
  id                    String   @id @default(uuid()) @db.Uuid
  event_key             String   @unique @db.VarChar(255)
  user_id               String
  entry_type            String   @db.VarChar(40)
  balance_delta         Decimal  @default(0) @db.Decimal(12, 2)
  reserved_delta        Decimal  @default(0) @db.Decimal(12, 2)
  total_earned_delta    Decimal  @default(0) @db.Decimal(12, 2)
  total_withdrawn_delta Decimal  @default(0) @db.Decimal(12, 2)
  commission_id         String?  @unique
  payout_id             String?
  source_kind           String   @db.VarChar(40)
  source_event_id       String   @db.VarChar(255)
  metadata              Json?
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  @@unique([payout_id, entry_type])
  @@index([user_id, created_at])
  @@index([source_kind, source_event_id])
  @@map("wallet_ledger_entries")
}

// Durable outbox written in the same transaction that makes an order
// delivered. Product Binary can then be retried without losing the obligation.
model ProductBinarySettlementJob {
  id                      String                   @id @default(uuid()) @db.Uuid
  order_id                String                   @unique
  status                  String                   @default("pending") @db.VarChar(48)
  qualification_status    String                   @default("awaiting_qualification") @db.VarChar(48)
  buyer_user_id           String?
  payment_status_snapshot String?                  @db.VarChar(20)
  paid_at_snapshot        DateTime?                @db.Timestamptz(6)
  delivered_at_snapshot   DateTime?                @db.Timestamptz(6)
  eligible_units_snapshot Int?
  total_pu_snapshot       Int?
  gross_margin_snapshot   Decimal?                 @db.Decimal(12, 2)
  snapshot_version        String?                  @db.VarChar(40)
  qualified_at            DateTime?                @db.Timestamptz(6)
  attempts                Int                      @default(0)
  last_error              String?
  next_attempt_at         DateTime                 @default(now()) @db.Timestamptz(6)
  completed_at            DateTime?                @db.Timestamptz(6)
  created_at              DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  order                   Order                    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  order_event             ProductBinaryOrderEvent?

  @@index([status, next_attempt_at])
  @@map("product_binary_settlement_jobs")
}

model Payout {
  id                                  String                            @id @default(uuid())
  user_id                             String
  amount                              Decimal                           @db.Decimal(10, 2)
  status                              PayoutStatus                      @default(pending)
  payment_method                      String?
  payment_reference                   String?
  transaction_number                  String?                           @unique
  cutoff_date                         DateTime?
  payout_date                         DateTime?
  batch_id                            String?                           @db.VarChar(40)
  notes                               String?
  approved_by                         String?
  requested_at                        DateTime                          @default(now())
  processed_at                        DateTime?
  released_at                         DateTime?                         @db.Timestamptz(6)
  disbursement_provider               String?                           @db.VarChar(80)
  external_reference                  String?                           @db.VarChar(160)
  disbursed_amount                    Decimal?                          @db.Decimal(10, 2)
  disbursed_at                        DateTime?                         @db.Timestamptz(6)
  released_by                         String?
  approver                            User?                             @relation("PayoutApprover", fields: [approved_by], references: [id])
  releaser                            User?                             @relation("PayoutReleaser", fields: [released_by], references: [id])
  user                                User                              @relation("PayoutUser", fields: [user_id], references: [id])
  direct_referral_payout_consumptions DirectReferralPayoutConsumption[]

  @@unique([disbursement_provider, external_reference])
  @@index([batch_id, status])
  @@map("payouts")
}

model PasswordResetToken {
  id           String    @id @default(uuid())
  user_id      String
  token_hash   String    @unique
  expires_at   DateTime
  used_at      DateTime?
  requested_by String
  created_at   DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@map("password_reset_tokens")
}

model DirectReferralReserveLot {
