  commission_id       String                            @unique
  user_id             String
  original_amount     Decimal                           @db.Decimal(12, 2)
  remaining_amount    Decimal                           @db.Decimal(12, 2)
  snapshot_source     String                            @db.VarChar
  allocated_at        DateTime
  created_at          DateTime                          @default(now())
  commission          Commission                        @relation(fields: [commission_id], references: [id])
  payout_consumptions DirectReferralPayoutConsumption[]
  forfeiture          PayableLotForfeiture?             @relation("DirectReferralLotForfeiture")

  @@index([user_id, remaining_amount, allocated_at])
  @@map("direct_referral_reserve_lots")
}

model DirectReferralPayoutConsumption {
  id             String                   @id @default(uuid()) @db.Uuid
  payout_id      String
  reserve_lot_id String                   @db.Uuid
  amount         Decimal                  @db.Decimal(12, 2)
  allocated_at   DateTime                 @default(now())
  payout         Payout                   @relation(fields: [payout_id], references: [id])
  reserve_lot    DirectReferralReserveLot @relation(fields: [reserve_lot_id], references: [id])

  @@unique([payout_id, reserve_lot_id])
  @@index([payout_id])
  @@index([reserve_lot_id])
  @@map("direct_referral_payout_consumptions")
}

model Order {
