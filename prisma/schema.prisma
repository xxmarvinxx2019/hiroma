  reseller_id                   String
  processed_by                  String
  flushed_points                Int
  points_value                  Decimal                @db.Decimal(12, 2)
  wallet_value                  Decimal                @db.Decimal(12, 2)
  total_flushed                 Decimal                @db.Decimal(12, 2)
  liability_liquidation_version String?                @default("deactivation-liability-v1") @db.VarChar(40)
