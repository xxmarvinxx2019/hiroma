  payment_evidence_at           DateTime?                   @db.Timestamptz(6)
  payment_recorded_by_actor_id  String?                     @db.Uuid
  payment_verified_by_actor_id  String?                     @db.Uuid
  financial_purpose             String                      @default("commerce") @db.VarChar(24)
  fulfillment_method            String                      @default("partner_pickup") @db.VarChar
  shipping_status               String?                     @db.VarChar
