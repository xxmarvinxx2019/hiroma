model OrderItem {
  id                           String    @id @default(uuid())
  order_id                     String
  product_id                   String
  quantity                     Int
  unit_price                   Decimal   @db.Decimal(10, 2)
  unit_acquisition_cost        Decimal?  @db.Decimal(10, 2)
  subtotal                     Decimal   @db.Decimal(10, 2)
  binary_eligible_snapshot     Boolean?
  pu_value_snapshot            Int?
  company_unit_cost_snapshot   Decimal?  @db.Decimal(10, 2)
  company_unit_margin_snapshot Decimal?  @db.Decimal(10, 2)
  snapshot_source              String?   @db.VarChar(40)
  snapshotted_at               DateTime? @db.Timestamptz(6)
  order                        Order     @relation(fields: [order_id], references: [id])
  product                      Product   @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

model PosTerminal {
  id                    String                  @id @default(uuid()) @db.Uuid
  owner_id              String
  installation_id       String                  @unique @db.VarChar(120)
  name                  String                  @db.VarChar(120)
  receipt_code          String                  @unique @db.VarChar(7)
  receipt_sequence_next Int                     @default(1)
  platform              String?                 @db.VarChar(80)
  is_active             Boolean                 @default(true)
  last_catalog_at       DateTime?               @db.Timestamptz(6)
  last_inventory_at     DateTime?               @db.Timestamptz(6)
  last_synced_at        DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @updatedAt @db.Timestamptz(6)
  owner                 User                    @relation("PosTerminalOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  shifts                PosShift[]
  transactions          PosTransaction[]
  sync_events           PosSyncEvent[]
  inventory_allowance   PosInventoryAllowance[]
  registration_intakes  PosRegistrationIntake[]
  cash_movements        PosCashMovement[]

  @@unique([owner_id, name])
  @@index([owner_id, is_active])
  @@map("pos_terminals")
}

model PosTerminalEnrollment {
  id                   String    @id @default(uuid()) @db.Uuid
  owner_id             String
  created_by_id        String
  terminal_name        String    @db.VarChar(120)
  code_hash            String    @unique @db.VarChar(64)
  expires_at           DateTime  @db.Timestamptz(6)
  used_at              DateTime? @db.Timestamptz(6)
  revoked_at           DateTime? @db.Timestamptz(6)
  enrolled_terminal_id String?   @unique @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  @@index([owner_id, expires_at])
  @@index([created_by_id, created_at])
  @@map("pos_terminal_enrollments")
}

model PosShift {
  id                     String                  @id @default(uuid()) @db.Uuid
  owner_id               String
  terminal_id            String                  @db.Uuid
  opened_by_id           String
  closed_by_id           String?
  status                 PosShiftStatus          @default(open)
  active_terminal_key    String?                 @unique @db.Uuid
  opening_cash           Decimal                 @default(0) @db.Decimal(12, 2)
  expected_cash_snapshot Decimal?                @db.Decimal(12, 2)
  counted_cash           Decimal?                @db.Decimal(12, 2)
  variance_snapshot      Decimal?                @db.Decimal(12, 2)
  closing_count_attempts Int                     @default(0)
  closing_explanation    String?                 @db.VarChar(1000)
  closing_submitted_at   DateTime?               @db.Timestamptz(6)
  opened_at              DateTime                @default(now()) @db.Timestamptz(6)
  local_closed_at        DateTime?               @db.Timestamptz(6)
  server_finalized_at    DateTime?               @db.Timestamptz(6)
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @updatedAt @db.Timestamptz(6)
  owner                  User                    @relation("PosShiftOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  terminal               PosTerminal             @relation(fields: [terminal_id], references: [id], onDelete: Restrict)
  opened_by              User                    @relation("PosShiftOpenedBy", fields: [opened_by_id], references: [id], onDelete: Restrict)
  closed_by              User?                   @relation("PosShiftClosedBy", fields: [closed_by_id], references: [id], onDelete: Restrict)
  transactions           PosTransaction[]
  registration_intakes   PosRegistrationIntake[]
  inventory_audit        InventoryAuditSession?
  cash_movements         PosCashMovement[]

  @@index([owner_id, status])
  @@index([terminal_id, opened_at])
  @@map("pos_shifts")
}

model PosCashMovement {
  id                String      @id @default(uuid()) @db.Uuid
  client_request_id String      @unique @db.Uuid
  owner_id          String
  shift_id          String      @db.Uuid
  terminal_id       String      @db.Uuid
  requested_by_id   String
  reviewed_by_id    String?
  movement_type     String      @db.VarChar(20)
  status            String      @db.VarChar(20)
  amount            Decimal     @db.Decimal(12, 2)
  purpose           String      @db.VarChar(80)
  notes             String      @db.VarChar(500)
  reference         String?     @db.VarChar(160)
  review_notes      String?     @db.VarChar(500)
  requested_at      DateTime    @default(now()) @db.Timestamptz(6)
  reviewed_at       DateTime?   @db.Timestamptz(6)
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  updated_at        DateTime    @updatedAt @db.Timestamptz(6)
  owner             User        @relation("PosCashMovementOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  shift             PosShift    @relation(fields: [shift_id], references: [id], onDelete: Restrict)
  terminal          PosTerminal @relation(fields: [terminal_id], references: [id], onDelete: Restrict)
  requested_by      User        @relation("PosCashMovementRequester", fields: [requested_by_id], references: [id], onDelete: Restrict)
  reviewed_by       User?       @relation("PosCashMovementReviewer", fields: [reviewed_by_id], references: [id], onDelete: Restrict)

  @@index([shift_id, status, requested_at])
  @@index([owner_id, status])
  @@map("pos_cash_movements")
}

// The client UUID is permanent across retries. The unique constraint is the
// server-side guard against duplicate orders, registrations, and stock release.
model PosTransaction {
  id                       String                 @id @default(uuid()) @db.Uuid
  client_transaction_id    String                 @unique @db.Uuid
  receipt_number           String                 @unique @db.VarChar(80)
  receipt_sequence         Int?
  owner_id                 String
  terminal_id              String                 @db.Uuid
  shift_id                 String?                @db.Uuid
  cashier_id               String
  payment_method_id        String?
  transaction_type         PosTransactionType
  status                   PosTransactionStatus   @default(pending_sync)
  member_id                String?
  customer_name_snapshot   String?
  payment_method_snapshot  String                 @db.VarChar(120)
  payment_reference        String?                @db.VarChar(160)
  subtotal_snapshot        Decimal                @db.Decimal(12, 2)
  discount_snapshot        Decimal                @default(0) @db.Decimal(12, 2)
  total_snapshot           Decimal                @db.Decimal(12, 2)
  amount_received_snapshot Decimal                @db.Decimal(12, 2)
  change_snapshot          Decimal                @default(0) @db.Decimal(12, 2)
  order_id                 String?                @unique
  registration_id          String?                @unique @db.Uuid
  registration_payload     Json?
  notes                    String?
  local_created_at         DateTime               @db.Timestamptz(6)
  server_received_at       DateTime?              @db.Timestamptz(6)
  finalized_at             DateTime?              @db.Timestamptz(6)
  reviewed_by_id           String?
  reviewed_at              DateTime?              @db.Timestamptz(6)
  review_notes             String?                @db.VarChar(500)
  created_at               DateTime               @default(now()) @db.Timestamptz(6)
  updated_at               DateTime               @updatedAt @db.Timestamptz(6)
  owner                    User                   @relation("PosTransactionOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  terminal                 PosTerminal            @relation(fields: [terminal_id], references: [id], onDelete: Restrict)
  shift                    PosShift?              @relation(fields: [shift_id], references: [id], onDelete: Restrict)
  cashier                  User                   @relation("PosTransactionCashier", fields: [cashier_id], references: [id], onDelete: Restrict)
  reviewer                 User?                  @relation("PosTransactionReviewer", fields: [reviewed_by_id], references: [id], onDelete: Restrict)
  member                   User?                  @relation("PosTransactionMember", fields: [member_id], references: [id], onDelete: Restrict)
  order                    Order?                 @relation(fields: [order_id], references: [id], onDelete: Restrict)
  items                    PosTransactionItem[]
  sync_events              PosSyncEvent[]
  adjustment_requests      PosAdjustmentRequest[]

  @@unique([payment_method_id, payment_reference])
  @@unique([terminal_id, receipt_sequence])
  @@index([owner_id, status, local_created_at])
  @@index([terminal_id, status])
  @@index([shift_id])
  @@index([owner_id, status, reviewed_at])
  @@map("pos_transactions")
}

// Completed receipts remain immutable. A separate request records who asked
// for a full void/refund, why, and which independent approver decided it.
model PosAdjustmentRequest {
  id                 String              @id @default(uuid()) @db.Uuid
  owner_id           String
  pos_transaction_id String              @db.Uuid
  requested_by_id    String
  reviewed_by_id     String?
  request_type       String              @db.VarChar(20)
  status             String              @default("pending") @db.VarChar(20)
  reason             String              @db.VarChar(500)
  review_notes       String?             @db.VarChar(500)
  amount_snapshot    Decimal             @db.Decimal(12, 2)
  requested_at       DateTime            @default(now()) @db.Timestamptz(6)
  reviewed_at        DateTime?           @db.Timestamptz(6)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @updatedAt @db.Timestamptz(6)
  transaction        PosTransaction      @relation(fields: [pos_transaction_id], references: [id], onDelete: Restrict)
  items              PosAdjustmentItem[]
  owner              User                @relation("PosAdjustmentOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  requester          User                @relation("PosAdjustmentRequester", fields: [requested_by_id], references: [id], onDelete: Restrict)
  reviewer           User?               @relation("PosAdjustmentReviewer", fields: [reviewed_by_id], references: [id], onDelete: Restrict)

  @@index([owner_id, status, requested_at])
  @@index([pos_transaction_id, status])
  @@map("pos_adjustment_requests")
}

model PosAdjustmentItem {
  id                      String               @id @default(uuid()) @db.Uuid
  adjustment_request_id   String               @db.Uuid
  pos_transaction_item_id String               @db.Uuid
  quantity                Int
  disposition             String               @db.VarChar(30)
  unit_price_snapshot     Decimal              @db.Decimal(12, 2)
  subtotal_snapshot       Decimal              @db.Decimal(12, 2)
  request                 PosAdjustmentRequest @relation(fields: [adjustment_request_id], references: [id], onDelete: Restrict)
  transaction_item        PosTransactionItem   @relation(fields: [pos_transaction_item_id], references: [id], onDelete: Restrict)

  @@unique([adjustment_request_id, pos_transaction_item_id])
  @@index([pos_transaction_item_id])
  @@map("pos_adjustment_items")
}

model PosTransactionItem {
  id                    String              @id @default(uuid()) @db.Uuid
  pos_transaction_id    String              @db.Uuid
  product_id            String
  product_name_snapshot String
  product_type_snapshot String              @db.VarChar(40)
  quantity              Int
  unit_price_snapshot   Decimal             @db.Decimal(12, 2)
  unit_cost_snapshot    Decimal             @db.Decimal(12, 2)
  pu_value_snapshot     Int                 @default(0)
  subtotal_snapshot     Decimal             @db.Decimal(12, 2)
  local_stock_before    Int
  local_stock_after     Int
  transaction           PosTransaction      @relation(fields: [pos_transaction_id], references: [id], onDelete: Cascade)
  adjustment_items      PosAdjustmentItem[]
  product               Product             @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([pos_transaction_id])
  @@index([product_id])
  @@map("pos_transaction_items")
}

model PosInventoryAllowance {
  id                 String      @id @default(uuid()) @db.Uuid
  owner_id           String
  terminal_id        String      @db.Uuid
  product_id         String
  allocated_quantity Int
  consumed_quantity  Int         @default(0)
  revision           Int         @default(1)
  expires_at         DateTime    @db.Timestamptz(6)
  created_at         DateTime    @default(now()) @db.Timestamptz(6)
  updated_at         DateTime    @updatedAt @db.Timestamptz(6)
  terminal           PosTerminal @relation(fields: [terminal_id], references: [id], onDelete: Cascade)
  product            Product     @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@unique([terminal_id, product_id])
  @@index([owner_id, expires_at])
  @@map("pos_inventory_allowances")
}

model PosSyncEvent {
  id                 String          @id @default(uuid()) @db.Uuid
  terminal_id        String          @db.Uuid
  pos_transaction_id String?         @db.Uuid
  event_type         String          @db.VarChar(80)
  outcome            String          @db.VarChar(40)
  request_checksum   String?         @db.VarChar(128)
  details            Json?
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  terminal           PosTerminal     @relation(fields: [terminal_id], references: [id], onDelete: Cascade)
  transaction        PosTransaction? @relation(fields: [pos_transaction_id], references: [id], onDelete: SetNull)

  @@index([terminal_id, created_at])
  @@index([pos_transaction_id, created_at])
  @@map("pos_sync_events")
}

// A POS registration intake is deliberately separate from the reseller
// account. It records payment and physical package release first, while the
// existing reseller registration workflow remains the only account creator.
// client_intake_id and released_at are the idempotency guards that prevent a
// retry from creating a second intake or deducting package stock twice.
model PosRegistrationIntake {
  id                          String                      @id @default(uuid()) @db.Uuid
  client_intake_id            String                      @unique @db.Uuid
  receipt_number              String                      @unique @db.VarChar(80)
  owner_id                    String
  terminal_id                 String                      @db.Uuid
  shift_id                    String                      @db.Uuid
  cashier_id                  String
  package_id                  String
  payment_method_id           String?
  pin_id                      String?                     @unique
  status                      PosRegistrationIntakeStatus @default(draft_intake)
  applicant_full_name         String                      @db.VarChar(180)
  applicant_mobile            String                      @db.VarChar(40)
  applicant_email             String?                     @db.VarChar(180)
  applicant_birthday          DateTime                    @db.Date
  applicant_birthplace        String                      @db.VarChar(240)
  applicant_address           Json
  identity_document_type      String?                     @db.VarChar(80)
  identity_document_reference String?                     @db.VarChar(180)
  identity_document_hash      String?                     @db.VarChar(64)
  referrer_username           String                      @db.VarChar(120)
  preferred_position          String?                     @db.VarChar(10)
  applicant_snapshot          Json
  payment_method_snapshot     String                      @db.VarChar(160)
  payment_reference           String?                     @db.VarChar(160)
  payment_proof_url           String?
  amount_snapshot             Decimal                     @db.Decimal(12, 2)
  registration_snapshot       Json?
  captured_offline            Boolean                     @default(false)
  payment_verified_at         DateTime?                   @db.Timestamptz(6)
  approver_id                 String?
  released_at                 DateTime?                   @db.Timestamptz(6)
  released_by_id              String?
  encoding_started_at         DateTime?                   @db.Timestamptz(6)
  encoder_id                  String?
  completed_at                DateTime?                   @db.Timestamptz(6)
  completed_user_id           String?                     @unique
  exception_reason            String?                     @db.VarChar(500)
  notes                       String?                     @db.VarChar(1000)
  local_created_at            DateTime                    @db.Timestamptz(6)
  server_received_at          DateTime                    @default(now()) @db.Timestamptz(6)
  created_at                  DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                    @updatedAt @db.Timestamptz(6)
  owner                       User                        @relation("PosRegistrationOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  terminal                    PosTerminal                 @relation(fields: [terminal_id], references: [id], onDelete: Restrict)
  shift                       PosShift                    @relation(fields: [shift_id], references: [id], onDelete: Restrict)
  cashier                     User                        @relation("PosRegistrationCashier", fields: [cashier_id], references: [id], onDelete: Restrict)
  approver                    User?                       @relation("PosRegistrationApprover", fields: [approver_id], references: [id], onDelete: Restrict)
  released_by                 User?                       @relation("PosRegistrationReleaser", fields: [released_by_id], references: [id], onDelete: Restrict)
  encoder                     User?                       @relation("PosRegistrationEncoder", fields: [encoder_id], references: [id], onDelete: Restrict)
  completed_user              User?                       @relation("PosRegistrationCompletedUser", fields: [completed_user_id], references: [id], onDelete: Restrict)
  package                     Package                     @relation(fields: [package_id], references: [id], onDelete: Restrict)
  pin                         Pin?                        @relation(fields: [pin_id], references: [id], onDelete: Restrict)
  events                      PosRegistrationEvent[]

  @@unique([payment_method_id, payment_reference])
  @@index([owner_id, status, created_at])
  @@index([owner_id, identity_document_hash, status])
  @@index([cashier_id, shift_id])
  @@index([terminal_id, created_at])
  @@map("pos_registration_intakes")
}

model PosRegistrationEvent {
  id          String                       @id @default(uuid()) @db.Uuid
  intake_id   String                       @db.Uuid
  actor_id    String
  from_status PosRegistrationIntakeStatus?
  to_status   PosRegistrationIntakeStatus
  action      String                       @db.VarChar(80)
  reason      String?                      @db.VarChar(500)
  metadata    Json?
  created_at  DateTime                     @default(now()) @db.Timestamptz(6)
  intake      PosRegistrationIntake        @relation(fields: [intake_id], references: [id], onDelete: Cascade)
  actor       User                         @relation("PosRegistrationEventActor", fields: [actor_id], references: [id], onDelete: Restrict)

  @@index([intake_id, created_at])
  @@index([actor_id, created_at])
  @@map("pos_registration_events")
}

model AddressGeocodeCache {
  id             String   @id @default(uuid()) @db.Uuid
  address_hash   String   @unique @db.VarChar
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  provider       String   @default("nominatim") @db.VarChar
  result_label   String?
  lookup_status  String   @default("found") @db.VarChar
  last_lookup_at DateTime @default(now()) @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  @@index([lookup_status, last_lookup_at])
  @@map("address_geocode_cache")
}

model Rank {
  id          String   @id @default(uuid())
  package_id  String
  name        String // custom name e.g. "Star", "Diamond"
  sequence    Int // display order 1, 2, 3...
  required_pu Int // PU needed to reach this rank
  pair_income Decimal  @db.Decimal(10, 2) // points per pair at this rank
  created_at  DateTime @default(now())
  package     Package  @relation(fields: [package_id], references: [id])

  @@unique([package_id, name])
  @@unique([package_id, sequence])
  @@map("ranks")
}

model RankPeriod {
  id         String   @id @default(uuid())
  package_id String
  start_date DateTime
  end_date   DateTime
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  package    Package  @relation(fields: [package_id], references: [id])

  @@map("rank_periods")
}

model PairingLog {
  id                String   @id @default(uuid())
  member_id         String
  left_points_used  Int      @default(0)
  right_points_used Int      @default(0)
  pairs_created     Int      @default(0)
  commission        Decimal  @db.Decimal(10, 2)
  date_created      DateTime @default(now()) @db.Timestamptz(6)
  member            User     @relation(fields: [member_id], references: [id])

  @@map("pairing_logs")
}

model PaymentMethod {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id        String
  type           String    @db.VarChar
  account_name   String    @db.VarChar
  account_number String    @db.VarChar
  bank_name      String?   @db.VarChar
  status         String    @default("pending") @db.VarChar
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("payment_methods")
}

// Permanent ownership boundary for reseller payout destinations. Only a hash
// of the provider/account tuple is stored; one verified identity may reuse the
// destination across its allowed accounts, but another identity cannot claim it.
model PayoutDestinationOwner {
  destination_hash    String   @id @db.VarChar(64)
  identity_hash       String   @db.VarChar(64)
  first_registered_by String
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @updatedAt @db.Timestamptz(6)

  @@index([identity_hash])
  @@map("payout_destination_owners")
}

model SystemSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt
  updated_by String?

  @@map("system_settings")
}

model AuditLog {
  id            String   @id @default(uuid())
  user_id       String?
  user_name     String?
  user_role     String?
  member_id     String?
  activity_type String
  category      String
  description   String
  metadata      Json     @default("{}")
  ip_address    String?
  device        String?
  risk_level    String   @default("low")
  status        String   @default("normal")
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([user_id, created_at])
  @@index([user_role, created_at])
  @@index([activity_type, created_at])
  @@index([category, created_at])
  @@index([risk_level, created_at])
  @@index([status, created_at])
  @@map("audit_logs")
}

model Notification {
  id          String    @id @default(uuid())
  user_id     String
  type        String    @db.VarChar
  title       String    @db.VarChar
  message     String
  amount      Decimal?  @db.Decimal(12, 2)
  entity_type String?   @db.VarChar
  entity_id   String?
  action_url  String?   @db.VarChar
  read_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([user_id, read_at])
  @@map("notifications")
}

model SupportRequest {
  id                    String                 @id @default(uuid())
  ticket_number         String                 @unique
  user_id               String?
  source                SupportRequestSource   @default(public)
  category              SupportRequestCategory
  category_detail       String?
  name                  String?
  email                 String?
  subject               String
  message               String
  status                SupportRequestStatus   @default(new)
  priority              SupportRequestPriority @default(normal)
  assigned_to           String?
  admin_notes           String?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  submitter             User?                  @relation(fields: [user_id], references: [id], onDelete: SetNull)
  assignee              User?                  @relation("SupportRequestAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  messages              SupportMessage[]
  attachments           SupportAttachment[]
  submitter_fingerprint String?
  email_fingerprint     String?

  @@index([status, created_at])
  @@index([source, created_at])
  @@index([user_id, created_at])
  @@index([assigned_to, status])
  @@index([submitter_fingerprint, created_at])
  @@index([email_fingerprint, created_at])
  @@map("support_requests")
}

model SupportCaptchaChallenge {
