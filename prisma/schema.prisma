generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String               @id @default(uuid())
  member_id                      String               @unique
  username                       String               @unique
  full_name                      String
  email                          String?
  mobile                         String
  profile_photo                  String?
  password_hash                  String
  login_disabled                 Boolean              @default(false)
  password_change_required       Boolean              @default(false)
  temporary_password_retained_at DateTime?
  password_is_temporary          Boolean              @default(false)
  password_retention_stage       Int                  @default(0)
  password_prompt_due_at         DateTime?
  password_changed_at            DateTime?
  two_factor_enabled             Boolean              @default(false)
  two_factor_pin_hash            String?
  two_factor_failed_attempts     Int                  @default(0)
  two_factor_locked_until        DateTime?
  role                           Role
  status                         UserStatus           @default(active)
  address                        String?
  zip_code                       String?
  identity_document_type         String?
  identity_document_hash         String?
  created_at                     DateTime             @default(now())
  created_by                     String?
  sponsored_nodes                BinaryTreeNode[]     @relation("TreeNodeSponsor")
  binary_tree_node               BinaryTreeNode?      @relation("TreeNodeOwner")
  commissions_overflow           Commission[]         @relation("CommissionOverflow")
  commissions_triggered          Commission[]         @relation("CommissionSource")
  commissions_earned             Commission[]         @relation("CommissionEarner")
  distributor_profile            DistributorProfile?
  inventory                      Inventory[]
  orders_bought                  Order[]              @relation("OrderBuyer")
  orders_sold                    Order[]              @relation("OrderSeller")
  payment_methods                PaymentMethod[]
  payouts_approved               Payout[]             @relation("PayoutApprover")
  payouts                        Payout[]             @relation("PayoutUser")
  pins_sold                      Pin[]                @relation("PinSoldTo")
  pins_generated                 Pin[]                @relation("PinGenerator")
  pins_used                      Pin[]                @relation("PinUsedBy")
  resellers_registered           ResellerProfile[]    @relation("ResellerRegisteredBy")
  reseller_profile               ResellerProfile?
  creator                        User?                @relation("UserCreatedBy", fields: [created_by], references: [id])
  created_users                  User[]               @relation("UserCreatedBy")
  wallet                         Wallet?
  pairing_logs                   PairingLog[]
  city_dist_pin_requests         PinRequest[]         @relation("CityDistPinRequests")
  staff_profile                  StaffProfile?        @relation("StaffAccount")
  staff_members                  StaffProfile[]       @relation("StaffOwner")
  notifications                  Notification[]
  password_reset_tokens          PasswordResetToken[]
  support_requests               SupportRequest[]
  assigned_support_requests      SupportRequest[]     @relation("SupportRequestAssignee")
  support_messages               SupportMessage[]
  passkey_test_enabled           Boolean              @default(false)
  passkey_credentials            PasskeyCredential[]
  passkey_challenges             PasskeyChallenge[]
  hiro_conversations            HiroConversation[]

  @@map("users")
}

model PasskeyCredential {
  id String @id @default(uuid())
  user_id String
  credential_id String @unique
  public_key Bytes
  counter BigInt @default(0)
  transports String[] @default([])
  device_name String
  device_type String?
  backed_up Boolean @default(false)
  created_at DateTime @default(now())
  last_used_at DateTime?
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id])
  @@map("passkey_credentials")
}

model PasskeyChallenge {
  id String @id @default(uuid())
  user_id String?
  challenge String
  purpose String
  device_name String?
  expires_at DateTime
  created_at DateTime @default(now())
  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id])
  @@index([expires_at])
  @@map("passkey_challenges")
}

model StaffProfile {
  id          String   @id @default(uuid())
  user_id     String   @unique
  owner_id    String
  staff_type  String   @default("custom")
  permissions Json     @default("[]")
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user        User     @relation("StaffAccount", fields: [user_id], references: [id], onDelete: Cascade)
  owner       User     @relation("StaffOwner", fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id])
  @@map("staff_profiles")
}

model DistributorProfile {
  id                                String                  @id @default(uuid())
  user_id                           String                  @unique
  dist_level                        DistributorLevel
  coverage_area                     String
  parent_dist_id                    String?
  contract_signed_at                DateTime?
  is_active                         Boolean                 @default(true)
  region_code                       String?
  region_name                       String?
  province_code                     String?
  province_name                     String?
  city_muni_code                    String?
  city_muni_name                    String?
  barangay_code                     String?
  barangay_name                     String?
  fulfillment_outlet_name           String?
  fulfillment_outlet_address        String?
  fulfillment_outlet_region_code    String?
  fulfillment_outlet_region_name    String?
  fulfillment_outlet_province_code  String?
  fulfillment_outlet_province_name  String?
  fulfillment_outlet_city_muni_code String?
  fulfillment_outlet_city_muni_name String?
  fulfillment_outlet_barangay_code  String?
  fulfillment_outlet_barangay_name  String?
  fulfillment_outlet_zip_code       String?
  parent                            DistributorProfile?     @relation("DistributorHierarchy", fields: [parent_dist_id], references: [id])
  children                          DistributorProfile[]    @relation("DistributorHierarchy")
  user                              User                    @relation(fields: [user_id], references: [id])
  product_visibility                ProductAreaVisibility[]

  @@map("distributor_profiles")
}

model ResellerProfile {
  id                      String    @id @default(uuid())
  user_id                 String    @unique
  package_id              String
  city_dist_id            String
  pin_id                  String    @unique
  total_points            Int       @default(0)
  points_reset_at         DateTime?
  daily_referral_count    Int       @default(0)
  last_referral_date      DateTime?
  daily_pairs_count       Int       @default(0)
  last_pairs_date         DateTime?
  pending_pairing_balance Decimal   @default(0) @db.Decimal(10, 2)
  left_points             Int?      @default(0)
  right_points            Int?      @default(0)
  daily_pairing_count     Int       @default(0)
  daily_pairing_date      DateTime? @db.Date
  rank                    String    @default("default")
  total_pu                Int       @default(0)
  city_dist               User      @relation("ResellerRegisteredBy", fields: [city_dist_id], references: [id])
  package                 Package   @relation(fields: [package_id], references: [id])
  pin                     Pin       @relation(fields: [pin_id], references: [id])
  user                    User      @relation(fields: [user_id], references: [id])

  @@map("reseller_profiles")
}

model Package {
  id                    String            @id @default(uuid())
  name                  String
  price                 Decimal           @db.Decimal(10, 2)
  direct_referral_bonus Decimal           @db.Decimal(10, 2)
  pairing_bonus_value   Decimal           @db.Decimal(10, 2)
  point_php_value       Decimal           @db.Decimal(10, 2)
  point_reset_days      Int               @default(30)
  is_active             Boolean           @default(true)
  created_at            DateTime          @default(now())
  products              PackageProduct[]
  pins                  Pin[]
  reseller_profiles     ResellerProfile[]
  pin_requests          PinRequest[]
  ranks                 Rank[]
  rank_periods          RankPeriod[]

  @@map("packages")
}

model PackageProduct {
  id         String  @id @default(uuid())
  package_id String
  product_id String
  quantity   Int
  package    Package @relation(fields: [package_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])

  @@map("package_products")
}

model Pin {
  id                                 String           @id @default(uuid())
  pin_code                           String           @unique
  package_id                         String
  city_dist_id                       String
  status                             PinStatus        @default(unused)
  used_by                            String?
  used_at                            DateTime?
  generated_by                       String
  // Registration PINs fund a new account. Upgrade PINs fund only the
  // incremental package difference and name the source package.
  pin_type                           String           @default("registration") @db.VarChar
  upgrade_from_package_id            String?          @db.Uuid
  pin_allocation_snapshot            Decimal?         @db.Decimal(12, 2)
  upgrade_customer_payment_snapshot  Decimal?         @db.Decimal(12, 2)
  upgrade_reseller_value_snapshot    Decimal?         @db.Decimal(12, 2)
  upgrade_acquisition_cost_snapshot  Decimal?         @db.Decimal(12, 2)
  upgrade_direct_allocation_snapshot Decimal?         @db.Decimal(12, 2)
  upgrade_binary_allocation_snapshot Decimal?         @db.Decimal(12, 2)
  upgrade_points_difference_snapshot Int?
  created_at                         DateTime         @default(now())
  city_distributor                   User             @relation("PinSoldTo", fields: [city_dist_id], references: [id])
  generator                          User             @relation("PinGenerator", fields: [generated_by], references: [id])
  package                            Package          @relation(fields: [package_id], references: [id])
  used_by_user                       User?            @relation("PinUsedBy", fields: [used_by], references: [id])
  reseller_profile                   ResellerProfile?

  @@index([city_dist_id, status])
  @@index([city_dist_id, pin_type, status])
  @@map("pins")
}

model Product {
  id               String                  @id @default(uuid())
  name             String
  description      String?
  type             ProductType
  price            Decimal                 @db.Decimal(10, 2)
  image_url        String?
  is_active        Boolean                 @default(true)
  created_at       DateTime                @default(now())
  cost_price       Decimal                 @default(0) @db.Decimal(10, 2)
  regional_price   Decimal                 @default(0) @db.Decimal(10, 2)
  provincial_price Decimal                 @default(0) @db.Decimal(10, 2)
  city_price       Decimal                 @default(0) @db.Decimal(10, 2)
  branch_price     Decimal                 @default(0) @db.Decimal(10, 2)
  reseller_price   Decimal                 @default(0) @db.Decimal(10, 2)
  pu_value         Int                     @default(0)
  binary_eligible  Boolean                 @default(true)
  inventory        Inventory[]
  order_items      OrderItem[]
  package_products PackageProduct[]
  area_visibility  ProductAreaVisibility[]

  @@map("products")
}

model ProductAreaVisibility {
  id             String             @id @default(uuid())
  product_id     String
  distributor_id String
  is_visible     Boolean            @default(true)
  distributor    DistributorProfile @relation(fields: [distributor_id], references: [id])
  product        Product            @relation(fields: [product_id], references: [id])

  @@unique([product_id, distributor_id])
  @@map("product_area_visibility")
}

model Inventory {
  id                  String   @id @default(uuid())
  owner_id            String
  product_id          String
  quantity            Int      @default(0)
  reserved_quantity   Int      @default(0)
  low_stock_threshold Int      @default(10)
  updated_at          DateTime @updatedAt
  owner               User     @relation(fields: [owner_id], references: [id])
  product             Product  @relation(fields: [product_id], references: [id])

  @@unique([owner_id, product_id])
  @@map("inventory")
}

model InventoryMovement {
  id                     String   @id @default(uuid())
  admin_id               String
  recipient_id           String
  product_id             String
  order_id               String?
  quantity               Int
  unit_cost              Decimal  @db.Decimal(10, 2)
  unit_price             Decimal  @db.Decimal(10, 2)
  reference_value        Decimal  @db.Decimal(12, 2)
  sale_value             Decimal  @db.Decimal(12, 2)
  admin_profit           Decimal  @db.Decimal(12, 2)
  is_sale                Boolean  @default(true)
  admin_stock_before     Int
  admin_stock_after      Int
  recipient_stock_before Int
  recipient_stock_after  Int
  notes                  String?
  created_at             DateTime @default(now())

  @@index([recipient_id, product_id, created_at])
  @@index([admin_id, created_at])
  @@map("inventory_movements")
}

model RegistrationFinancial {
  id                           String    @id @default(uuid())
  pin_id                       String    @unique
  city_dist_id                 String
  reseller_id                  String
  package_id                   String
  customer_payment             Decimal   @db.Decimal(12, 2)
  product_acquisition_cost     Decimal   @db.Decimal(12, 2)
  reseller_value               Decimal   @db.Decimal(12, 2)
  pin_allocation               Decimal   @db.Decimal(12, 2)
  registration_profit          Decimal   @db.Decimal(12, 2)
  package_name_snapshot        String
  direct_referral_allocation   Decimal   @db.Decimal(12, 2)
  binary_commission_allocation Decimal   @db.Decimal(12, 2)
  binary_points_per_pair       Int
  binary_point_peso_rate       Decimal   @db.Decimal(8, 4)
  registration_channel         String    @default("legacy") @db.VarChar
  allocation_snapshot_source   String    @default("estimated_legacy") @db.VarChar
  payment_status               String    @default("paid") @db.VarChar
  paid_at                      DateTime?
  created_at                   DateTime  @default(now())

  @@index([city_dist_id, created_at])
  @@index([city_dist_id, paid_at])
  @@index([reseller_id])
  @@map("registration_financials")
}

// Immutable economics for a package upgrade. Package registrations and upgrades
// do not create Product Binary PU or Rank PU.
model UpgradeFinancial {
  id                           String    @id @default(uuid())
  upgrade_pin_id               String    @unique
  city_dist_id                 String
  reseller_id                  String
  from_package_id              String
  to_package_id                String
  customer_payment             Decimal   @db.Decimal(12, 2)
  product_acquisition_cost     Decimal   @db.Decimal(12, 2)
  reseller_value               Decimal   @db.Decimal(12, 2)
  pin_allocation               Decimal   @db.Decimal(12, 2)
  registration_profit          Decimal   @db.Decimal(12, 2)
  direct_referral_allocation   Decimal   @db.Decimal(12, 2)
  direct_referral_paid         Decimal   @default(0) @db.Decimal(12, 2)
  direct_referral_retained     Decimal   @db.Decimal(12, 2)
  binary_commission_allocation Decimal   @db.Decimal(12, 2)
  binary_points_difference     Int
  from_package_name_snapshot   String
  to_package_name_snapshot     String
  allocation_snapshot_source   String    @default("upgrade_pin_snapshot") @db.VarChar
  payment_status               String    @default("paid") @db.VarChar
  paid_at                      DateTime?
  created_at                   DateTime  @default(now())

  @@index([city_dist_id, created_at])
  @@index([reseller_id, created_at])
  @@map("upgrade_financials")
}

model BinaryReserveLot {
  id                        String   @id @default(uuid())
  registration_financial_id String?  @unique
  upgrade_financial_id      String?  @unique
  original_amount           Decimal  @db.Decimal(12, 2)
  remaining_amount          Decimal  @db.Decimal(12, 2)
  snapshot_source           String   @db.VarChar
  allocated_at              DateTime
  created_at                DateTime @default(now())

  @@index([remaining_amount, allocated_at])
  @@map("binary_reserve_lots")
}

model BinaryReserveConsumption {
  id             String   @id @default(uuid())
  reserve_lot_id String?
  commission_id  String
  amount         Decimal  @db.Decimal(12, 2)
  is_unfunded    Boolean  @default(false)
  consumed_at    DateTime @default(now())

  @@index([commission_id])
  @@index([reserve_lot_id])
  @@map("binary_reserve_consumptions")
}

// Exact, immutable audit record for every ancestor whose left/right volume
// produced one or more completed registration-binary pairs.
model BinaryPairEvent {
  id                      String   @id @default(uuid()) @db.Uuid
  recipient_user_id       String
  source_user_id          String
  source_kind             String   @db.VarChar
  source_leg              String   @db.VarChar
  source_points           Int
  recipient_package_id    String?
  package_name_snapshot   String   @default("Unknown") @db.VarChar
  pair_value_snapshot     Decimal  @default(0) @db.Decimal(12, 2)
  package_snapshot_source String   @default("exact_event") @db.VarChar
  points_per_pair         Int
  peso_per_point          Decimal  @db.Decimal(8, 4)
  completed_pairs         Int
  payable_pairs           Int
  cap_flashout_pairs      Int
  inactive_flashout_pairs Int
  consumed_left_points    Int
  consumed_right_points   Int
  payable_amount          Decimal  @db.Decimal(12, 2)
  flashout_amount         Decimal  @db.Decimal(12, 2)
  cap_enabled             Boolean
  cap_limit               Int?
  normal_commission_id    String?
  flashout_commission_id  String?
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([recipient_user_id, created_at])
  @@index([recipient_package_id, created_at])
  @@index([source_user_id, created_at])
  @@map("binary_pair_events")
}

// Member-earned binary commission remains a payable liability until the
// allocated payout is actually released. This is intentionally separate from
// BinaryReserveLot, which is the company's funding pool.
model BinaryPayableLot {
  id               String   @id @default(uuid()) @db.Uuid
  commission_id    String   @unique
  user_id          String
  original_amount  Decimal  @db.Decimal(12, 2)
  remaining_amount Decimal  @db.Decimal(12, 2)
  allocated_at     DateTime @db.Timestamptz(6)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, remaining_amount, allocated_at])
  @@map("binary_payable_lots")
}

model BinaryPayoutConsumption {
  id             String   @id @default(uuid()) @db.Uuid
  payout_id      String
  payable_lot_id String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  allocated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([payout_id, payable_lot_id])
  @@index([payout_id])
  @@index([payable_lot_id])
  @@map("binary_payout_consumptions")
}

// Product Binary is separate from registration binary. Product purchases add
// PU to an upline leg; 2 PU left + 2 PU right complete one pair.
model ProductBinaryPosition {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @unique
  left_carryover_pu   Int      @default(0)
  right_carryover_pu  Int      @default(0)
  lifetime_pairs      Int      @default(0)
  lifetime_payable    Int      @default(0)
  lifetime_flashout   Int      @default(0)
  updated_at          DateTime @updatedAt @db.Timestamptz(6)

  @@map("product_binary_positions")
}

model ProductBinaryOrderEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  order_id              String   @unique
  buyer_user_id         String
  eligible_units        Int
  total_pu              Int
  recorded_gross_margin Decimal  @db.Decimal(12, 2)
  processed_at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([processed_at])
  @@index([buyer_user_id, processed_at])
  @@map("product_binary_order_events")
}

model ProductBinaryPairEvent {
  id                       String   @id @default(uuid()) @db.Uuid
  order_event_id           String   @db.Uuid
  recipient_user_id        String
  source_user_id           String
  source_leg               String   @db.VarChar
  source_pu                Int
  opening_left_pu          Int
  opening_right_pu         Int
  completed_pairs          Int
  payable_pairs            Int
  cap_flashout_pairs       Int
  inactive_flashout_pairs  Int
  closing_left_pu          Int
  closing_right_pu         Int
  package_id_snapshot      String?
  package_name_snapshot    String   @db.VarChar
  rank_id_snapshot         String?
  rank_name_snapshot       String   @db.VarChar
  pair_rate_points         Decimal  @db.Decimal(12, 2)
  peso_per_point           Decimal  @db.Decimal(8, 4)
  pair_rate_amount         Decimal  @db.Decimal(12, 2)
  payable_amount           Decimal  @db.Decimal(12, 2)
  flashout_amount          Decimal  @db.Decimal(12, 2)
  cap_enabled              Boolean
  cap_limit                Int?
  normal_commission_id     String?
  flashout_commission_id   String?
  created_at               DateTime @default(now()) @db.Timestamptz(6)

  @@unique([order_event_id, recipient_user_id])
  @@index([created_at])
  @@index([recipient_user_id, created_at])
  @@index([rank_name_snapshot, created_at])
  @@map("product_binary_pair_events")
}

model ProductBinaryPayableLot {
  id               String   @id @default(uuid()) @db.Uuid
  commission_id    String   @unique
  user_id          String
  original_amount  Decimal  @db.Decimal(12, 2)
  remaining_amount Decimal  @db.Decimal(12, 2)
  allocated_at     DateTime @db.Timestamptz(6)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, remaining_amount, allocated_at])
  @@map("product_binary_payable_lots")
}

model ProductBinaryPayoutConsumption {
  id             String   @id @default(uuid()) @db.Uuid
  payout_id      String
  payable_lot_id String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  allocated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([payout_id, payable_lot_id])
  @@index([payout_id])
  @@index([payable_lot_id])
  @@map("product_binary_payout_consumptions")
}

// Company-side funding is sourced from realized Admin product gross margin.
// It is separate from the member payable liability and payout status.
model ProductBinaryFundingLot {
  id                    String   @id @default(uuid()) @db.Uuid
  inventory_movement_id String?  @unique @db.Uuid
  original_amount       Decimal  @db.Decimal(12, 2)
  remaining_amount      Decimal  @db.Decimal(12, 2)
  snapshot_source       String   @db.VarChar
  allocated_at          DateTime @db.Timestamptz(6)
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  @@index([remaining_amount, allocated_at])
  @@map("product_binary_funding_lots")
}

model ProductBinaryFundingConsumption {
  id             String   @id @default(uuid()) @db.Uuid
  funding_lot_id String?  @db.Uuid
  commission_id  String
  amount         Decimal  @db.Decimal(12, 2)
  is_unfunded    Boolean  @default(false)
  consumed_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([commission_id])
  @@index([funding_lot_id])
  @@map("product_binary_funding_consumptions")
}

model BinaryTreeNode {
  id          String           @id @default(uuid())
  user_id     String           @unique
  parent_id   String?
  position    TreePosition?
  sponsor_id  String?
  left_count  Int              @default(0)
  right_count Int              @default(0)
  is_overflow Boolean          @default(false)
  created_at  DateTime         @default(now())
  parent      BinaryTreeNode?  @relation("TreeHierarchy", fields: [parent_id], references: [id])
  children    BinaryTreeNode[] @relation("TreeHierarchy")
  sponsor     User?            @relation("TreeNodeSponsor", fields: [sponsor_id], references: [id])
  user        User             @relation("TreeNodeOwner", fields: [user_id], references: [id])

  @@unique([parent_id, position])
  @@map("binary_tree_nodes")
}

model PinRequest {
  id                  String    @id @default(uuid())
  city_dist_id        String
  package_id          String
  quantity            Int       @default(1)
  total_amount        Decimal   @db.Decimal(10, 2)
  payment_method      String    @default("cash_on_pickup") @db.VarChar
  payment_reference   String?   @db.VarChar
  payment_sender_name String?   @db.VarChar
  payment_datetime    DateTime? @db.Timestamptz(6)
  payment_status      String    @default("unpaid") @db.VarChar
  status              String    @default("pending") @db.VarChar
  notes               String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)
  city_dist           User      @relation("CityDistPinRequests", fields: [city_dist_id], references: [id])
  package             Package   @relation(fields: [package_id], references: [id])

  @@map("pin_requests")
}

model NameCapRegistry {
  id              String   @id @default(uuid())
  normalized_name String   @unique
  count           Int      @default(0)
  max_allowed     Int      @default(7)
  updated_at      DateTime @updatedAt

  @@map("name_cap_registry")
}

model IdentityAccountLimit {
  identity_hash String   @id @db.VarChar(64)
  count         Int      @default(0)
  max_allowed   Int      @default(7)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  @@map("identity_account_limits")
}

model ResellerDeactivationEvent {
  id                  String   @id @default(uuid())
  reseller_id         String
  processed_by        String
  flushed_points      Int
  points_value        Decimal  @db.Decimal(12, 2)
  wallet_value        Decimal  @db.Decimal(12, 2)
  total_flushed       Decimal  @db.Decimal(12, 2)
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([reseller_id, created_at])
  @@map("reseller_deactivation_events")
}

model Wallet {
  id              String   @id @default(uuid())
  user_id         String   @unique
  balance         Decimal  @default(0) @db.Decimal(10, 2)
  reserved_balance Decimal @default(0) @db.Decimal(10, 2)
  total_earned    Decimal  @default(0) @db.Decimal(10, 2)
  total_withdrawn Decimal  @default(0) @db.Decimal(10, 2)
  updated_at      DateTime @updatedAt
  user            User     @relation(fields: [user_id], references: [id])

  @@map("wallets")
}

model Commission {
  id                          String                    @id @default(uuid())
  event_key                   String?                   @unique @db.VarChar(255)
  user_id                     String
  type                        CommissionType
  amount                      Decimal                   @db.Decimal(10, 2)
  points                      Int?
  source_user_id              String?
  cascade_remainder           Decimal?                  @db.Decimal(10, 2)
  is_pair_overflow            Boolean                   @default(false)
  overflow_to                 String?
  created_at                  DateTime                  @default(now())
  overflow_user               User?                     @relation("CommissionOverflow", fields: [overflow_to], references: [id])
  source_user                 User?                     @relation("CommissionSource", fields: [source_user_id], references: [id])
  user                        User                      @relation("CommissionEarner", fields: [user_id], references: [id])
  direct_referral_reserve_lot DirectReferralReserveLot?

  @@map("commissions")
}

model Payout {
  id                                  String                            @id @default(uuid())
  user_id                             String
  amount                              Decimal                           @db.Decimal(10, 2)
  status                              PayoutStatus                      @default(pending)
  payment_method                      String?
  payment_reference                   String?
  transaction_number                  String?                           @unique
  cutoff_date                         DateTime?
  payout_date                         DateTime?
  notes                               String?
  approved_by                         String?
  requested_at                        DateTime                          @default(now())
  processed_at                        DateTime?
  released_at                         DateTime?                         @db.Timestamptz(6)
  approver                            User?                             @relation("PayoutApprover", fields: [approved_by], references: [id])
  user                                User                              @relation("PayoutUser", fields: [user_id], references: [id])
  direct_referral_payout_consumptions DirectReferralPayoutConsumption[]

  @@map("payouts")
}

model PasswordResetToken {
  id           String    @id @default(uuid())
  user_id      String
  token_hash   String    @unique
  expires_at   DateTime
  used_at      DateTime?
  requested_by String
  created_at   DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@map("password_reset_tokens")
}

model DirectReferralReserveLot {
  id                  String                            @id @default(uuid()) @db.Uuid
  commission_id       String                            @unique
  user_id             String
  original_amount     Decimal                           @db.Decimal(12, 2)
  remaining_amount    Decimal                           @db.Decimal(12, 2)
  snapshot_source     String                            @db.VarChar
  allocated_at        DateTime
  created_at          DateTime                          @default(now())
  commission          Commission                        @relation(fields: [commission_id], references: [id])
  payout_consumptions DirectReferralPayoutConsumption[]

  @@index([user_id, remaining_amount, allocated_at])
  @@map("direct_referral_reserve_lots")
}

model DirectReferralPayoutConsumption {
  id             String                   @id @default(uuid()) @db.Uuid
  payout_id      String
  reserve_lot_id String                   @db.Uuid
  amount         Decimal                  @db.Decimal(12, 2)
  allocated_at   DateTime                 @default(now())
  payout         Payout                   @relation(fields: [payout_id], references: [id])
  reserve_lot    DirectReferralReserveLot @relation(fields: [reserve_lot_id], references: [id])

  @@unique([payout_id, reserve_lot_id])
  @@index([payout_id])
  @@index([reserve_lot_id])
  @@map("direct_referral_payout_consumptions")
}

model Order {
  id                 String      @id @default(uuid())
  order_number       String?     @unique
  buyer_id           String
  seller_id          String
  order_type         OrderType
  status             OrderStatus @default(pending)
  total_amount       Decimal     @db.Decimal(10, 2)
  is_cross_purchase  Boolean     @default(false)
  payment_method     String?     @default("cash") @db.VarChar
  payment_reference  String?     @db.VarChar
  payment_status     String?     @default("unpaid") @db.VarChar
  is_non_member_sale Boolean     @default(false)
  customer_name      String?
  delivery_address   String?
  notes              String?
  delivered_at       DateTime?
  paid_at            DateTime?
  created_at         DateTime    @default(now())
  updated_at         DateTime    @default(now()) @updatedAt
  buyer              User        @relation("OrderBuyer", fields: [buyer_id], references: [id])
  seller             User        @relation("OrderSeller", fields: [seller_id], references: [id])
  items              OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                    String   @id @default(uuid())
  order_id              String
  product_id            String
  quantity              Int
  unit_price            Decimal  @db.Decimal(10, 2)
  unit_acquisition_cost Decimal? @db.Decimal(10, 2)
  subtotal              Decimal  @db.Decimal(10, 2)
  order                 Order    @relation(fields: [order_id], references: [id])
  product               Product  @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

model Rank {
  id          String   @id @default(uuid())
  package_id  String
  name        String // custom name e.g. "Star", "Diamond"
  sequence    Int // display order 1, 2, 3...
  required_pu Int // PU needed to reach this rank
  pair_income Decimal  @db.Decimal(10, 2) // points per pair at this rank
  created_at  DateTime @default(now())
  package     Package  @relation(fields: [package_id], references: [id])

  @@unique([package_id, name])
  @@unique([package_id, sequence])
  @@map("ranks")
}

model RankPeriod {
  id         String   @id @default(uuid())
  package_id String
  start_date DateTime
  end_date   DateTime
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  package    Package  @relation(fields: [package_id], references: [id])

  @@map("rank_periods")
}

model PairingLog {
  id                String   @id @default(uuid())
  member_id         String
  left_points_used  Int      @default(0)
  right_points_used Int      @default(0)
  pairs_created     Int      @default(0)
  commission        Decimal  @db.Decimal(10, 2)
  date_created      DateTime @default(now()) @db.Timestamptz(6)
  member            User     @relation(fields: [member_id], references: [id])

  @@map("pairing_logs")
}

model PaymentMethod {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id        String
  type           String    @db.VarChar
  account_name   String    @db.VarChar
  account_number String    @db.VarChar
  bank_name      String?   @db.VarChar
  status         String    @default("pending") @db.VarChar
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("payment_methods")
}

model SystemSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt
  updated_by String?

  @@map("system_settings")
}

model AuditLog {
  id            String   @id @default(uuid())
  user_id       String?
  user_name     String?
  user_role     String?
  member_id     String?
  activity_type String
  category      String
  description   String
  metadata      Json     @default("{}")
  ip_address    String?
  device        String?
  risk_level    String   @default("low")
  status        String   @default("normal")
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([user_id, created_at])
  @@index([user_role, created_at])
  @@index([activity_type, created_at])
  @@index([category, created_at])
  @@index([risk_level, created_at])
  @@index([status, created_at])
  @@map("audit_logs")
}

model Notification {
  id          String    @id @default(uuid())
  user_id     String
  type        String    @db.VarChar
  title       String    @db.VarChar
  message     String
  amount      Decimal?  @db.Decimal(12, 2)
  entity_type String?   @db.VarChar
  entity_id   String?
  action_url  String?   @db.VarChar
  read_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([user_id, read_at])
  @@map("notifications")
}

model SupportRequest {
  id              String                 @id @default(uuid())
  ticket_number   String                 @unique
  user_id         String?
  source          SupportRequestSource   @default(public)
  category        SupportRequestCategory
  category_detail String?
  name            String?
  email           String?
  subject         String
  message         String
  status          SupportRequestStatus   @default(new)
  priority        SupportRequestPriority @default(normal)
  assigned_to     String?
  admin_notes     String?
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  submitter       User?                  @relation(fields: [user_id], references: [id], onDelete: SetNull)
  assignee        User?                  @relation("SupportRequestAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  messages        SupportMessage[]
  attachments     SupportAttachment[]
  submitter_fingerprint String?
  email_fingerprint     String?

  @@index([status, created_at])
  @@index([source, created_at])
  @@index([user_id, created_at])
  @@index([assigned_to, status])
  @@index([submitter_fingerprint, created_at])
  @@index([email_fingerprint, created_at])
  @@map("support_requests")
}

model SupportCaptchaChallenge {
  id                 String   @id @default(uuid())
  answer_digest      String
  client_fingerprint String
  expires_at         DateTime @db.Timestamptz(6)
  used_at            DateTime? @db.Timestamptz(6)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([client_fingerprint, created_at])
  @@index([expires_at])
  @@map("support_captcha_challenges")
}

model PublicVerificationRateLimit {
  bucket_key    String   @db.VarChar(80)
  window_start DateTime @db.Timestamptz(6)
  request_count Int
  expires_at    DateTime @db.Timestamptz(6)

  @@id([bucket_key, window_start])
  @@index([expires_at])
  @@map("public_verification_rate_limits")
}

model LoginRateLimit {
  bucket_key    String   @db.VarChar(80)
  window_start DateTime @db.Timestamptz(6)
  request_count Int
  expires_at    DateTime @db.Timestamptz(6)

  @@id([bucket_key, window_start])
  @@index([expires_at])
  @@map("login_rate_limits")
}

model SupportMessage {
  id          String         @id @default(uuid())
  request_id  String
  author_id   String?
  author_name String
  author_role String
  message     String
  created_at  DateTime       @default(now())
  request     SupportRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  author      User?          @relation(fields: [author_id], references: [id], onDelete: SetNull)

  @@index([request_id, created_at])
  @@map("support_messages")
}

model SupportAttachment {
  id           String         @id @default(uuid())
  request_id   String
  storage_path String
  filename     String
  mime_type    String
  created_at   DateTime       @default(now())
  request      SupportRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@map("support_attachments")
}

model HiroConversation {
  id            String                 @id @default(uuid())
  user_id       String
  status        HiroConversationStatus @default(active)
  started_at    DateTime               @default(now())
  last_activity DateTime               @default(now())
  closed_at     DateTime?
  close_reason  String?
  user          User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages      HiroMessage[]

  @@index([user_id, status, last_activity])
  @@map("hiro_conversations")
}

model HiroMessage {
  id              String           @id @default(uuid())
  conversation_id String
  role            HiroMessageRole
  text            String
  intent          String?
  links           Json?
  created_at      DateTime         @default(now())
  conversation    HiroConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("hiro_messages")
}

enum HiroConversationStatus {
  active
  closed
}

enum HiroMessageRole {
  user
  hiro
  system
}

enum Role {
  admin
  regional
  provincial
  city
  reseller
  staff
}

enum UserStatus {
  active
  inactive
  suspended
}

enum DistributorLevel {
  regional
  provincial
  city
  branch
}

enum PinStatus {
  unused
  used
  expired
  cancelled
}

enum ProductType {
  physical
  digital
}

enum TreePosition {
  left
  right
}

enum CommissionType {
  direct_referral
  binary_pairing
  multilevel
  sponsor_point
}

enum OrderType {
  online
  offline
}

enum OrderStatus {
  pending
  processing
  ready_for_pickup
  delivered
  cancelled
}

enum PayoutStatus {
  pending
  approved
  rejected
  released
}

enum SupportRequestSource {
  public
  member
}

enum SupportRequestCategory {
  suggestion
  feedback
  bug
  support
  account_access
  profile_and_verification
  digital_id
  registration_and_pin
  referral_and_sponsorship
  binary_tree_and_genealogy
  commissions_and_points
  wallet_and_payout
  orders_and_delivery
  products_and_pricing
  payment_issue
  website_or_app_problem
  security_and_account_safety
  other
}

enum SupportRequestStatus {
  new
  reviewing
  resolved
}

enum SupportRequestPriority {
  low
  normal
  high
  urgent
}

model WalkInMemberScanProof {
  id             String    @id @default(uuid())
  token_hash     String    @unique @db.VarChar(64)
  reseller_id    String
  distributor_id String
  expires_at     DateTime  @db.Timestamptz(6)
  used_at        DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([distributor_id, expires_at])
  @@index([expires_at])
  @@map("walk_in_member_scan_proofs")
}
