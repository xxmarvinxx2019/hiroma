  seller                        User                        @relation("OrderSeller", fields: [seller_id], references: [id])
  items                         OrderItem[]
  pos_transaction               PosTransaction?
  funded_pins                   Pin[]                       @relation("PinFundingOrder")
  product_binary_order_event    ProductBinaryOrderEvent?
  product_binary_funding_lot    ProductBinaryFundingLot?
