  inventory_audit        InventoryAuditSession?

  @@index([owner_id, status])
  @@index([terminal_id, opened_at])
  @@map("pos_shifts")
}

// The client UUID is permanent across retries. The unique constraint is the
// server-side guard against duplicate orders, registrations, and stock release.
model PosTransaction {
  id                       String                @id @default(uuid()) @db.Uuid
  client_transaction_id    String                @unique @db.Uuid
  receipt_number           String                @unique @db.VarChar(80)
  receipt_sequence         Int?
  owner_id                 String
  terminal_id              String                @db.Uuid
  shift_id                 String?               @db.Uuid
  cashier_id               String
  payment_method_id        String?
  transaction_type         PosTransactionType
  status                   PosTransactionStatus  @default(pending_sync)
  member_id                String?
  customer_name_snapshot   String?
  payment_method_snapshot  String                @db.VarChar(120)
  payment_reference        String?               @db.VarChar(160)
  subtotal_snapshot        Decimal               @db.Decimal(12, 2)
  discount_snapshot        Decimal               @default(0) @db.Decimal(12, 2)
  total_snapshot           Decimal               @db.Decimal(12, 2)
  amount_received_snapshot Decimal               @db.Decimal(12, 2)
  change_snapshot          Decimal               @default(0) @db.Decimal(12, 2)
  order_id                 String?               @unique
  registration_id          String?               @unique @db.Uuid
  registration_payload     Json?
  notes                    String?
  local_created_at         DateTime              @db.Timestamptz(6)
  server_received_at       DateTime?             @db.Timestamptz(6)
  finalized_at             DateTime?             @db.Timestamptz(6)
  reviewed_by_id           String?
  reviewed_at              DateTime?             @db.Timestamptz(6)
  review_notes             String?               @db.VarChar(500)
  created_at               DateTime              @default(now()) @db.Timestamptz(6)
  updated_at               DateTime              @updatedAt @db.Timestamptz(6)
  owner                    User                  @relation("PosTransactionOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  terminal                 PosTerminal           @relation(fields: [terminal_id], references: [id], onDelete: Restrict)
  shift                    PosShift?             @relation(fields: [shift_id], references: [id], onDelete: Restrict)
  cashier                  User                  @relation("PosTransactionCashier", fields: [cashier_id], references: [id], onDelete: Restrict)
  reviewer                 User?                 @relation("PosTransactionReviewer", fields: [reviewed_by_id], references: [id], onDelete: Restrict)
  member                   User?                 @relation("PosTransactionMember", fields: [member_id], references: [id], onDelete: Restrict)
  order                    Order?                @relation(fields: [order_id], references: [id], onDelete: Restrict)
  items                    PosTransactionItem[]
  sync_events              PosSyncEvent[]
  adjustment_request       PosAdjustmentRequest?

  @@unique([payment_method_id, payment_reference])
  @@unique([terminal_id, receipt_sequence])
  @@index([owner_id, status, local_created_at])
  @@index([terminal_id, status])
  @@index([shift_id])
  @@index([owner_id, status, reviewed_at])
  @@map("pos_transactions")
}

// Completed receipts remain immutable. A separate request records who asked
// for a full void/refund, why, and which independent approver decided it.
model PosAdjustmentRequest {
  id                 String         @id @default(uuid()) @db.Uuid
  owner_id           String
  pos_transaction_id String         @unique @db.Uuid
  requested_by_id    String
  reviewed_by_id     String?
  request_type       String         @db.VarChar(20)
  status             String         @default("pending") @db.VarChar(20)
  reason             String         @db.VarChar(500)
  review_notes       String?        @db.VarChar(500)
  amount_snapshot    Decimal        @db.Decimal(12, 2)
  requested_at       DateTime       @default(now()) @db.Timestamptz(6)
  reviewed_at        DateTime?      @db.Timestamptz(6)
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @updatedAt @db.Timestamptz(6)
  transaction        PosTransaction @relation(fields: [pos_transaction_id], references: [id], onDelete: Restrict)
  owner              User           @relation("PosAdjustmentOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  requester          User           @relation("PosAdjustmentRequester", fields: [requested_by_id], references: [id], onDelete: Restrict)
  reviewer           User?          @relation("PosAdjustmentReviewer", fields: [reviewed_by_id], references: [id], onDelete: Restrict)

  @@index([owner_id, status, requested_at])
  @@map("pos_adjustment_requests")
}

model PosTransactionItem {
