  reason              String?
  metadata            Json?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_id, created_at])
  @@index([owner_id, event_type, created_at])
  @@index([product_id, created_at])
  @@map("inventory_audit_events")
}

