  window_start  DateTime @db.Timestamptz(6)
  request_count Int
  expires_at    DateTime @db.Timestamptz(6)

  @@id([bucket_key, window_start])
  @@index([expires_at])
  @@map("public_verification_rate_limits")
}

model LoginRateLimit {
  bucket_key    String   @db.VarChar(80)
  window_start  DateTime @db.Timestamptz(6)
  request_count Int
  expires_at    DateTime @db.Timestamptz(6)

  @@id([bucket_key, window_start])
  @@index([expires_at])
  @@map("login_rate_limits")
}

model SupportMessage {
  id          String         @id @default(uuid())
  request_id  String
  author_id   String?
  author_name String
  author_role String
  message     String
  created_at  DateTime       @default(now())
  request     SupportRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  author      User?          @relation(fields: [author_id], references: [id], onDelete: SetNull)

  @@index([request_id, created_at])
  @@map("support_messages")
}

model SupportAttachment {
  id           String         @id @default(uuid())
  request_id   String
  storage_path String
  filename     String
  mime_type    String
  created_at   DateTime       @default(now())
  request      SupportRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@map("support_attachments")
}

model HiroConversation {
  id            String                 @id @default(uuid())
  user_id       String
  status        HiroConversationStatus @default(active)
  started_at    DateTime               @default(now())
  last_activity DateTime               @default(now())
  closed_at     DateTime?
  close_reason  String?
  user          User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages      HiroMessage[]

  @@index([user_id, status, last_activity])
  @@map("hiro_conversations")
}

model HiroMessage {
  id              String           @id @default(uuid())
  conversation_id String
  role            HiroMessageRole
  text            String
  intent          String?
  links           Json?
  created_at      DateTime         @default(now())
  conversation    HiroConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("hiro_messages")
}

