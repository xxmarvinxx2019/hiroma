  parent_node_id  String
  source_leg      String   @db.VarChar
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([source_kind, source_event_id])
  @@index([source_user_id, created_at])
  @@map("binary_settlement_events")
}

// Member-earned binary commission remains a payable liability until the
