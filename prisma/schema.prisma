model HiroMessage {
  id              String           @id @default(uuid())
  conversation_id String
  role            HiroMessageRole
  text            String
  intent          String?
  links           Json?
  created_at      DateTime         @default(now())
  conversation    HiroConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("hiro_messages")
}

