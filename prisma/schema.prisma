// Immutable evidence that deactivation extinguished each member-earned
// payable liability at the same time as the wallet forfeiture.
model PayableLotForfeiture {
  id                    String                    @id @default(uuid()) @db.Uuid
  deactivation_event_id String
  source_type           String                    @db.VarChar(32)
  direct_lot_id         String?                   @unique @db.Uuid
  binary_lot_id         String?                   @unique @db.Uuid
  product_binary_lot_id String?                   @unique @db.Uuid
  amount                Decimal                   @db.Decimal(12, 2)
  created_at            DateTime                  @default(now()) @db.Timestamptz(6)
  deactivation_event    ResellerDeactivationEvent @relation(fields: [deactivation_event_id], references: [id])
  direct_lot            DirectReferralReserveLot? @relation("DirectReferralLotForfeiture", fields: [direct_lot_id], references: [id])
  binary_lot            BinaryPayableLot?         @relation("BinaryPayableLotForfeiture", fields: [binary_lot_id], references: [id])
  product_binary_lot    ProductBinaryPayableLot?  @relation("ProductBinaryPayableLotForfeiture", fields: [product_binary_lot_id], references: [id])

  @@index([deactivation_event_id, source_type])
  @@map("payable_lot_forfeitures")
}

model Wallet {
