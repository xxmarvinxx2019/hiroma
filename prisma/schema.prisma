generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                String                  @id @default(uuid())
  member_id                         String                  @unique
  username                          String                  @unique
  full_name                         String
  email                             String?
  mobile                            String
  profile_photo                     String?
  password_hash                     String
  login_disabled                    Boolean                 @default(false)
  password_change_required          Boolean                 @default(false)
  temporary_password_retained_at    DateTime?
  password_is_temporary             Boolean                 @default(false)
  password_retention_stage          Int                     @default(0)
  password_prompt_due_at            DateTime?
  password_changed_at               DateTime?
  two_factor_enabled                Boolean                 @default(false)
  two_factor_pin_hash               String?
  two_factor_failed_attempts        Int                     @default(0)
  two_factor_locked_until           DateTime?
  role                              Role
  status                            UserStatus              @default(active)
  address                           String?
  zip_code                          String?
  street_address                    String?
  region_code                       String?
  region_name                       String?
  province_code                     String?
  province_name                     String?
  city_muni_code                    String?
  city_muni_name                    String?
  barangay_code                     String?
  barangay_name                     String?
  identity_document_type            String?
  identity_document_hash            String?
  created_at                        DateTime                @default(now())
  created_by                        String?
  sponsored_nodes                   BinaryTreeNode[]        @relation("TreeNodeSponsor")
  binary_tree_node                  BinaryTreeNode?         @relation("TreeNodeOwner")
  commissions_overflow              Commission[]            @relation("CommissionOverflow")
  commissions_triggered             Commission[]            @relation("CommissionSource")
  commissions_earned                Commission[]            @relation("CommissionEarner")
  distributor_profile               DistributorProfile?
  inventory                         Inventory[]
  orders_bought                     Order[]                 @relation("OrderBuyer")
  orders_sold                       Order[]                 @relation("OrderSeller")
  payment_methods                   PaymentMethod[]
  payouts_approved                  Payout[]                @relation("PayoutApprover")
  payouts_released                  Payout[]                @relation("PayoutReleaser")
  payouts                           Payout[]                @relation("PayoutUser")
  pins_sold                         Pin[]                   @relation("PinSoldTo")
  pins_generated                    Pin[]                   @relation("PinGenerator")
  pins_used                         Pin[]                   @relation("PinUsedBy")
  resellers_registered              ResellerProfile[]       @relation("ResellerRegisteredBy")
  reseller_profile                  ResellerProfile?
  creator                           User?                   @relation("UserCreatedBy", fields: [created_by], references: [id])
  created_users                     User[]                  @relation("UserCreatedBy")
  wallet                            Wallet?
  pairing_logs                      PairingLog[]
  city_dist_pin_requests            PinRequest[]            @relation("CityDistPinRequests")
  staff_profile                     StaffProfile?           @relation("StaffAccount")
  staff_members                     StaffProfile[]          @relation("StaffOwner")
  notifications                     Notification[]
  password_reset_tokens             PasswordResetToken[]
  support_requests                  SupportRequest[]
  assigned_support_requests         SupportRequest[]        @relation("SupportRequestAssignee")
  support_messages                  SupportMessage[]
  passkey_test_enabled              Boolean                 @default(false)
  passkey_credentials               PasskeyCredential[]
  passkey_challenges                PasskeyChallenge[]
  hiro_conversations                HiroConversation[]
  pos_terminals                     PosTerminal[]           @relation("PosTerminalOwner")
  pos_shifts                        PosShift[]              @relation("PosShiftOwner")
  pos_shifts_opened                 PosShift[]              @relation("PosShiftOpenedBy")
  pos_shifts_closed                 PosShift[]              @relation("PosShiftClosedBy")
  pos_transactions                  PosTransaction[]        @relation("PosTransactionOwner")
  pos_transactions_created          PosTransaction[]        @relation("PosTransactionCashier")
  pos_transactions_reviewed         PosTransaction[]        @relation("PosTransactionReviewer")
  pos_transactions_as_member        PosTransaction[]        @relation("PosTransactionMember")
  pos_registration_intakes          PosRegistrationIntake[] @relation("PosRegistrationOwner")
  pos_registration_intakes_created  PosRegistrationIntake[] @relation("PosRegistrationCashier")
  pos_registration_intakes_approved PosRegistrationIntake[] @relation("PosRegistrationApprover")
  pos_registration_intakes_released PosRegistrationIntake[] @relation("PosRegistrationReleaser")
  pos_registration_intakes_encoded  PosRegistrationIntake[] @relation("PosRegistrationEncoder")
  pos_registration_accounts         PosRegistrationIntake[] @relation("PosRegistrationCompletedUser")
  pos_registration_events           PosRegistrationEvent[]  @relation("PosRegistrationEventActor")
  pos_adjustment_requests_created   PosAdjustmentRequest[]  @relation("PosAdjustmentRequester")
  pos_adjustment_requests_reviewed  PosAdjustmentRequest[]  @relation("PosAdjustmentReviewer")
  pos_adjustment_requests_owned     PosAdjustmentRequest[]  @relation("PosAdjustmentOwner")
  pos_cash_movements_owned          PosCashMovement[]       @relation("PosCashMovementOwner")
  pos_cash_movements_requested      PosCashMovement[]       @relation("PosCashMovementRequester")
  pos_cash_movements_reviewed       PosCashMovement[]       @relation("PosCashMovementReviewer")

  @@map("users")
}

// Permanent high-water mark for each Manila registration year. It is not
// derived from live users, so deleting an account never lowers the sequence.
model MemberIdSequence {
  year          String @id
  last_sequence Int

  @@map("member_id_sequences")
}

// Append-only tombstone for every public Member ID ever issued or recovered
// from authoritative legacy evidence. It deliberately survives user deletion.
model MemberIdIssuance {
  member_id           String   @id
  year                String
  sequence            Int
  evidence_source     String   @db.VarChar(32)
  evidence_subject_id String?
  allocated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([year, sequence])
  @@index([allocated_at])
  @@map("member_id_issuances")
}

model PasskeyCredential {
  id            String    @id @default(uuid())
  user_id       String
  credential_id String    @unique
  public_key    Bytes
  counter       BigInt    @default(0)
  transports    String[]  @default([])
  device_name   String
  device_type   String?
  backed_up     Boolean   @default(false)
  created_at    DateTime  @default(now())
  last_used_at  DateTime?
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("passkey_credentials")
}

model PasskeyChallenge {
  id          String   @id @default(uuid())
  user_id     String?
  challenge   String
  purpose     String
  device_name String?
  expires_at  DateTime
  created_at  DateTime @default(now())
  user        User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("passkey_challenges")
}

model StaffProfile {
  id          String   @id @default(uuid())
  user_id     String   @unique
  owner_id    String
  staff_type  String   @default("custom")
  permissions Json     @default("[]")
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user        User     @relation("StaffAccount", fields: [user_id], references: [id], onDelete: Cascade)
  owner       User     @relation("StaffOwner", fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id])
  @@map("staff_profiles")
}

model DistributorProfile {
  id                                String                  @id @default(uuid())
  user_id                           String                  @unique
  dist_level                        DistributorLevel
  coverage_area                     String
  parent_dist_id                    String?
  contract_signed_at                DateTime?
  is_active                         Boolean                 @default(true)
  region_code                       String?
  region_name                       String?
  province_code                     String?
  province_name                     String?
  city_muni_code                    String?
  city_muni_name                    String?
  barangay_code                     String?
  barangay_name                     String?
  fulfillment_outlet_name           String?
  fulfillment_outlet_address        String?
  fulfillment_outlet_region_code    String?
  fulfillment_outlet_region_name    String?
  fulfillment_outlet_province_code  String?
  fulfillment_outlet_province_name  String?
  fulfillment_outlet_city_muni_code String?
  fulfillment_outlet_city_muni_name String?
  fulfillment_outlet_barangay_code  String?
  fulfillment_outlet_barangay_name  String?
  fulfillment_outlet_zip_code       String?
  fulfillment_latitude              Decimal?                @db.Decimal(10, 7)
  fulfillment_longitude             Decimal?                @db.Decimal(10, 7)
  parent                            DistributorProfile?     @relation("DistributorHierarchy", fields: [parent_dist_id], references: [id])
  children                          DistributorProfile[]    @relation("DistributorHierarchy")
  user                              User                    @relation(fields: [user_id], references: [id])
  product_visibility                ProductAreaVisibility[]

  @@map("distributor_profiles")
}

model ResellerProfile {
  id                          String    @id @default(uuid())
  user_id                     String    @unique
  package_id                  String
  city_dist_id                String
  pin_id                      String    @unique
  total_points                Int       @default(0)
  points_reset_at             DateTime?
  daily_referral_count        Int       @default(0)
  last_referral_date          DateTime?
  daily_pairs_count           Int       @default(0)
  last_pairs_date             DateTime?
  pending_pairing_balance     Decimal   @default(0) @db.Decimal(10, 2)
  left_points                 Int?      @default(0)
  right_points                Int?      @default(0)
  daily_pairing_count         Int       @default(0)
  daily_pairing_date          DateTime? @db.Date
  rank                        String    @default("default")
  total_pu                    Int       @default(0)
  qualification_quarter_start DateTime? @db.Timestamptz(6)
  is_active                   Boolean   @default(true)
  city_dist                   User      @relation("ResellerRegisteredBy", fields: [city_dist_id], references: [id])
  package                     Package   @relation(fields: [package_id], references: [id])
  pin                         Pin       @relation(fields: [pin_id], references: [id])
  user                        User      @relation(fields: [user_id], references: [id])

  @@map("reseller_profiles")
}

model Package {
  id                       String                  @id @default(uuid())
  name                     String
  price                    Decimal                 @db.Decimal(10, 2)
  direct_referral_bonus    Decimal                 @db.Decimal(10, 2)
  pairing_bonus_value      Decimal                 @db.Decimal(10, 2)
  point_php_value          Decimal                 @db.Decimal(10, 2)
  point_reset_days         Int                     @default(30)
  is_active                Boolean                 @default(true)
  created_at               DateTime                @default(now())
  products                 PackageProduct[]
  upgrade_paths_from       PackageUpgradePath[]    @relation("UpgradePathSource")
  upgrade_paths_to         PackageUpgradePath[]    @relation("UpgradePathTarget")
  pins                     Pin[]
  reseller_profiles        ResellerProfile[]
  pin_requests             PinRequest[]
  ranks                    Rank[]
  rank_periods             RankPeriod[]
  pos_registration_intakes PosRegistrationIntake[]

  @@map("packages")
}

model PackageProduct {
  id         String  @id @default(uuid())
  package_id String
  product_id String
  quantity   Int
  package    Package @relation(fields: [package_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])

  @@map("package_products")
}

model PackageUpgradePath {
  id              String                  @id @default(uuid()) @db.Uuid
  from_package_id String
  to_package_id   String
  customer_price  Decimal                 @db.Decimal(12, 2)
  pin_price       Decimal                 @db.Decimal(12, 2)
  is_active       Boolean                 @default(true)
  created_at      DateTime                @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                @updatedAt @db.Timestamptz(6)
  from_package    Package                 @relation("UpgradePathSource", fields: [from_package_id], references: [id], onDelete: Cascade)
  to_package      Package                 @relation("UpgradePathTarget", fields: [to_package_id], references: [id], onDelete: Cascade)
  products        PackageUpgradeProduct[]

  @@unique([from_package_id, to_package_id])
  @@index([to_package_id, is_active])
  @@map("package_upgrade_paths")
}

model PackageUpgradeProduct {
  id              String             @id @default(uuid()) @db.Uuid
  upgrade_path_id String             @db.Uuid
  product_id      String
  quantity        Int
  upgrade_path    PackageUpgradePath @relation(fields: [upgrade_path_id], references: [id], onDelete: Cascade)
  product         Product            @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@unique([upgrade_path_id, product_id])
  @@map("package_upgrade_products")
}

model Pin {
  id                                       String                           @id @default(uuid())
  pin_code                                 String                           @unique
  package_id                               String
  city_dist_id                             String
  status                                   PinStatus                        @default(unused)
  used_by                                  String?
  used_at                                  DateTime?
  cancelled_at                             DateTime?
  cancelled_by                             String?                          @db.Uuid
  cancellation_reason                      String?                          @db.VarChar(500)
  cancellation_disposition                 String?                          @db.VarChar(32)
  cancellation_reference                   String?                          @db.VarChar(120)
  cancellation_amount                      Decimal?                         @db.Decimal(12, 2)
  generated_by                             String
  generated_by_actor_id                    String?                          @db.Uuid
  funding_order_id                         String?
  funding_pin_request_id                   String?
  funding_pin_transfer_id                  String?                          @db.Uuid
  // Registration PINs fund a new account. Upgrade PINs fund only the
  // incremental package difference and name the source package.
  pin_type                                 String                           @default("registration") @db.VarChar
  upgrade_from_package_id                  String?
  pin_allocation_snapshot                  Decimal?                         @db.Decimal(12, 2)
  registration_package_name_snapshot       String?                          @db.VarChar
  registration_customer_payment_snapshot   Decimal?                         @db.Decimal(12, 2)
  registration_reseller_value_snapshot     Decimal?                         @db.Decimal(12, 2)
  registration_acquisition_cost_snapshot   Decimal?                         @db.Decimal(12, 2)
  registration_acquisition_tier_snapshot   String?                          @db.VarChar(16)
  registration_direct_allocation_snapshot  Decimal?                         @db.Decimal(12, 2)
  registration_binary_allocation_snapshot  Decimal?                         @db.Decimal(12, 2)
  registration_points_snapshot             Int?
  registration_product_line_count_snapshot Int?
  registration_units_snapshot              Int?
  upgrade_customer_payment_snapshot        Decimal?                         @db.Decimal(12, 2)
  upgrade_reseller_value_snapshot          Decimal?                         @db.Decimal(12, 2)
  upgrade_acquisition_cost_snapshot        Decimal?                         @db.Decimal(12, 2)
  upgrade_acquisition_tier_snapshot        String?                          @db.VarChar(16)
  upgrade_direct_allocation_snapshot       Decimal?                         @db.Decimal(12, 2)
  upgrade_binary_allocation_snapshot       Decimal?                         @db.Decimal(12, 2)
  upgrade_points_difference_snapshot       Int?
  upgrade_product_line_count_snapshot      Int?
  upgrade_units_snapshot                   Int?
  created_at                               DateTime                         @default(now())
  city_distributor                         User                             @relation("PinSoldTo", fields: [city_dist_id], references: [id])
  generator                                User                             @relation("PinGenerator", fields: [generated_by], references: [id])
  package                                  Package                          @relation(fields: [package_id], references: [id])
  used_by_user                             User?                            @relation("PinUsedBy", fields: [used_by], references: [id])
  reseller_profile                         ResellerProfile?
  pos_registration_intake                  PosRegistrationIntake?
  upgrade_product_snapshots                PinUpgradeProductSnapshot[]
  registration_product_snapshots           PinRegistrationProductSnapshot[]
  funding_order                            Order?                           @relation("PinFundingOrder", fields: [funding_order_id], references: [id], onDelete: Restrict)
  funding_pin_request                      PinRequest?                      @relation("PinFundingRequest", fields: [funding_pin_request_id], references: [id], onDelete: Restrict)
  funding_pin_transfer                     PinTransfer?                     @relation(fields: [funding_pin_transfer_id], references: [id], onDelete: Restrict)

  @@index([city_dist_id, status])
  @@index([city_dist_id, pin_type, status])
  @@index([funding_order_id])
  @@index([funding_pin_request_id])
  @@index([funding_pin_transfer_id])
  @@map("pins")
}

// Zero-revenue internal custody transfer from Admin to a Branch. PINs stay
// in_transit and unusable until the named branch accepts the complete batch.
model PinTransfer {
  id                      String    @id @default(uuid()) @db.Uuid
  reference_number        String    @unique @db.VarChar(40)
  admin_id                String
  recipient_id            String
  initiated_by_actor_id   String?   @db.Uuid
  package_id              String
  pin_type                String    @db.VarChar(24)
  upgrade_from_package_id String?
  quantity                Int
  unit_allocation         Decimal   @db.Decimal(12, 2)
  reference_value         Decimal   @db.Decimal(12, 2)
  sale_value              Decimal   @default(0) @db.Decimal(12, 2)
  status                  String    @default("in_transit") @db.VarChar(32)
  notes                   String?
  dispatched_at           DateTime  @default(now()) @db.Timestamptz(6)
  received_at             DateTime? @db.Timestamptz(6)
  received_by_actor_id    String?   @db.Uuid
  rejected_at             DateTime? @db.Timestamptz(6)
  rejected_by_actor_id    String?   @db.Uuid
  rejection_reason        String?   @db.VarChar(500)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)
  pins                    Pin[]

  @@index([recipient_id, status, created_at])
  @@index([admin_id, created_at])
  @@map("pin_transfers")
}

model PinRegistrationProductSnapshot {
  id                             String  @id @default(uuid()) @db.Uuid
  pin_id                         String
  product_id                     String
  quantity                       Int
  srp_snapshot                   Decimal @db.Decimal(10, 2)
  reseller_price_snapshot        Decimal @db.Decimal(10, 2)
  unit_acquisition_cost_snapshot Decimal @db.Decimal(10, 2)
  pin                            Pin     @relation(fields: [pin_id], references: [id], onDelete: Cascade)
  product                        Product @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@unique([pin_id, product_id])
  @@map("pin_registration_product_snapshots")
}

model PinUpgradeProductSnapshot {
  id                             String   @id @default(uuid()) @db.Uuid
  pin_id                         String
  product_id                     String
  quantity                       Int
  srp_snapshot                   Decimal? @db.Decimal(10, 2)
  reseller_price_snapshot        Decimal? @db.Decimal(10, 2)
  unit_acquisition_cost_snapshot Decimal? @db.Decimal(10, 2)
  pin                            Pin      @relation(fields: [pin_id], references: [id], onDelete: Cascade)
  product                        Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@unique([pin_id, product_id])
  @@map("pin_upgrade_product_snapshots")
}

model Product {
  id                                 String                           @id @default(uuid())
  barcode                            String?                          @unique
  name                               String
  description                        String?
  type                               ProductType
  price                              Decimal                          @db.Decimal(10, 2)
  image_url                          String?
  is_active                          Boolean                          @default(true)
  created_at                         DateTime                         @default(now())
  cost_price                         Decimal                          @default(0) @db.Decimal(10, 2)
  regional_price                     Decimal                          @default(0) @db.Decimal(10, 2)
  provincial_price                   Decimal                          @default(0) @db.Decimal(10, 2)
  city_price                         Decimal                          @default(0) @db.Decimal(10, 2)
  branch_price                       Decimal                          @default(0) @db.Decimal(10, 2)
  reseller_price                     Decimal                          @default(0) @db.Decimal(10, 2)
  pu_value                           Int                              @default(0)
  binary_eligible                    Boolean                          @default(true)
  inventory                          Inventory[]
  order_items                        OrderItem[]
  pos_items                          PosTransactionItem[]
  pos_allowances                     PosInventoryAllowance[]
  package_products                   PackageProduct[]
  package_upgrade_products           PackageUpgradeProduct[]
  pin_upgrade_product_snapshots      PinUpgradeProductSnapshot[]
  pin_registration_product_snapshots PinRegistrationProductSnapshot[]
  area_visibility                    ProductAreaVisibility[]

  @@map("products")
}

model ProductAreaVisibility {
  id             String             @id @default(uuid())
  product_id     String
  distributor_id String
  is_visible     Boolean            @default(true)
  distributor    DistributorProfile @relation(fields: [distributor_id], references: [id])
  product        Product            @relation(fields: [product_id], references: [id])

  @@unique([product_id, distributor_id])
  @@map("product_area_visibility")
}

model Inventory {
  id                  String   @id @default(uuid())
  owner_id            String
  product_id          String
  quantity            Int      @default(0)
  reserved_quantity   Int      @default(0)
  low_stock_threshold Int      @default(10)
  updated_at          DateTime @updatedAt
  owner               User     @relation(fields: [owner_id], references: [id])
  product             Product  @relation(fields: [product_id], references: [id])

  @@unique([owner_id, product_id])
  @@map("inventory")
}

model InventoryMovement {
  id                     String    @id @default(uuid())
  transfer_id            String?   @db.Uuid
  admin_id               String
  recipient_id           String
  product_id             String
  order_id               String?
  quantity               Int
  unit_cost              Decimal   @db.Decimal(10, 2)
  unit_price             Decimal   @db.Decimal(10, 2)
  reference_value        Decimal   @db.Decimal(12, 2)
  sale_value             Decimal   @db.Decimal(12, 2)
  admin_profit           Decimal   @db.Decimal(12, 2)
  is_sale                Boolean   @default(true)
  admin_stock_before     Int
  admin_stock_after      Int
  recipient_stock_before Int
  recipient_stock_after  Int
  accepted_quantity      Int?
  damaged_quantity       Int?
  missing_quantity       Int?
  receiving_notes        String?
  received_at            DateTime?
  notes                  String?
  created_at             DateTime  @default(now())

  @@index([recipient_id, product_id, created_at])
  @@index([transfer_id])
  @@index([admin_id, created_at])
  @@map("inventory_movements")
}

model InventoryTransfer {
  id                     String    @id @default(uuid()) @db.Uuid
  reference_number       String    @unique @db.VarChar
  admin_id               String
  dispatched_by_actor_id String?   @db.Uuid
  recipient_id           String
  status                 String    @default("in_transit") @db.VarChar
  reference_value        Decimal   @db.Decimal(12, 2)
  notes                  String?
  dispatched_at          DateTime  @default(now()) @db.Timestamptz(6)
  received_at            DateTime? @db.Timestamptz(6)
  received_by            String?
  received_by_actor_id   String?   @db.Uuid
  receiving_notes        String?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @updatedAt @db.Timestamptz(6)

  @@index([recipient_id, status, created_at])
  @@index([admin_id, created_at])
  @@map("inventory_transfers")
}

// Append-only provenance for stock entering Admin custody. Inventory cannot
// be increased by the production/receipt endpoint without one of these rows.
model AdminStockReceipt {
  id                   String                  @id @default(uuid()) @db.Uuid
  reference_number     String                  @unique @db.VarChar(40)
  source_type          String                  @db.VarChar(32)
  source_reference     String                  @db.VarChar(120)
  source_reference_key String                  @db.VarChar(120)
  admin_id             String
  received_by_actor_id String?                 @db.Uuid
  total_units          Int
  notes                String?
  received_at          DateTime                @default(now()) @db.Timestamptz(6)
  created_at           DateTime                @default(now()) @db.Timestamptz(6)
  items                AdminStockReceiptItem[]

  @@unique([admin_id, source_type, source_reference_key], map: "admin_stock_receipts_source_reference_key")
  @@index([admin_id, received_at])
  @@index([source_type, source_reference])
  @@map("admin_stock_receipts")
}

model AdminStockReceiptItem {
  id           String            @id @default(uuid()) @db.Uuid
  receipt_id   String            @db.Uuid
  product_id   String
  quantity     Int
  unit_cost    Decimal           @db.Decimal(10, 2)
  stock_before Int
  stock_after  Int
  created_at   DateTime          @default(now()) @db.Timestamptz(6)
  receipt      AdminStockReceipt @relation(fields: [receipt_id], references: [id], onDelete: Restrict)

  @@unique([receipt_id, product_id])
  @@index([product_id, created_at])
  @@map("admin_stock_receipt_items")
}

// Snapshot-based physical inventory audit. A session freezes the expected
// quantities at the start of a count so later sales cannot rewrite history.
model InventoryAuditSession {
  id                       String               @id @default(uuid()) @db.Uuid
  reference_number         String               @unique @db.VarChar
  owner_id                 String
  status                   String               @default("counting") @db.VarChar
  scope                    String               @default("full") @db.VarChar
  started_by               String
  started_by_name_snapshot String               @db.VarChar
  notes                    String?
  submitted_at             DateTime?            @db.Timestamptz(6)
  approved_at              DateTime?            @db.Timestamptz(6)
  approved_by              String?
  approval_notes           String?
  started_at               DateTime             @default(now()) @db.Timestamptz(6)
  created_at               DateTime             @default(now()) @db.Timestamptz(6)
  updated_at               DateTime             @updatedAt @db.Timestamptz(6)
