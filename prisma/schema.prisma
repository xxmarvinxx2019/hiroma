  @@unique([source_kind, source_event_id, recipient_user_id])
  @@index([created_at])
  @@index([recipient_user_id, created_at])
  @@index([recipient_package_id, created_at])
  @@index([source_user_id, created_at])
  @@map("binary_pair_events")
}

// One immutable marker per registration/upgrade volume event. This protects
// carryover points even when an event does not immediately complete a pair.
model BinarySettlementEvent {
  id              String   @id @default(uuid()) @db.Uuid
  source_kind     String   @db.VarChar
  source_event_id String   @db.VarChar(255)
  source_user_id  String
