}

model PosTerminal {
  id                    String                  @id @default(uuid()) @db.Uuid
  owner_id              String
  installation_id       String                  @unique @db.VarChar(120)
  name                  String                  @db.VarChar(120)
  receipt_code          String                  @unique @db.VarChar(7)
  receipt_sequence_next Int                     @default(1)
  platform              String?                 @db.VarChar(80)
  is_active             Boolean                 @default(true)
  last_catalog_at       DateTime?               @db.Timestamptz(6)
  last_inventory_at     DateTime?               @db.Timestamptz(6)
  last_synced_at        DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @updatedAt @db.Timestamptz(6)
  owner                 User                    @relation("PosTerminalOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  shifts                PosShift[]
  transactions          PosTransaction[]
  sync_events           PosSyncEvent[]
  inventory_allowance   PosInventoryAllowance[]
  registration_intakes  PosRegistrationIntake[]

  @@unique([owner_id, name])
  @@index([owner_id, is_active])
  @@map("pos_terminals")
}

model PosShift {
  id                     String                  @id @default(uuid()) @db.Uuid
  owner_id               String
  terminal_id            String                  @db.Uuid
  opened_by_id           String
  closed_by_id           String?
  status                 PosShiftStatus          @default(open)
  active_terminal_key    String?                 @unique @db.Uuid
  opening_cash           Decimal                 @default(0) @db.Decimal(12, 2)
  expected_cash_snapshot Decimal?                @db.Decimal(12, 2)
  counted_cash           Decimal?                @db.Decimal(12, 2)
  variance_snapshot      Decimal?                @db.Decimal(12, 2)
  closing_count_attempts Int                     @default(0)
  closing_explanation    String?                 @db.VarChar(1000)
  closing_submitted_at   DateTime?               @db.Timestamptz(6)
  opened_at              DateTime                @default(now()) @db.Timestamptz(6)
  local_closed_at        DateTime?               @db.Timestamptz(6)
  server_finalized_at    DateTime?               @db.Timestamptz(6)
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @updatedAt @db.Timestamptz(6)
  owner                  User                    @relation("PosShiftOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  terminal               PosTerminal             @relation(fields: [terminal_id], references: [id], onDelete: Restrict)
  opened_by              User                    @relation("PosShiftOpenedBy", fields: [opened_by_id], references: [id], onDelete: Restrict)
  closed_by              User?                   @relation("PosShiftClosedBy", fields: [closed_by_id], references: [id], onDelete: Restrict)
  transactions           PosTransaction[]
